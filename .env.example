# ============================================================
# FON-ITA — Environment Variables (template)
# ============================================================
# Copy to `.env.local` and fill in real values.
# NEVER commit `.env.local`.
# Claude must NEVER read .env / .env.local — refer to this file instead.

# --- CMU OAuth credentials (obtain from CMU IT office) -----
CLIENT_ID=
CLIENT_SECRET=
SCOPE=

# --- Microsoft Entra ID endpoints + CMU basicinfo ----------
# Pre-filled — do not change unless CMU IT instructs.
AUTH_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/authorize
TOKEN_URL=https://login.microsoftonline.com/cf81f1df-de59-4c29-91da-a2dfd04aa751/oauth2/v2.0/token
BASICINFO_URL=https://api.cmu.ac.th/mis/cmuaccount/prod/v3/me/basicinfo

# --- OAuth callback -----------------------------------------
# Must match exactly what is registered in Azure portal.
REDIRECT_URI=http://localhost:3000/fonita/api/auth/callback

# --- Auth: session cookie ----------------------------------
# NOTE: sessions are opaque tokens stored server-side (decisions.md D2) — nothing
# is signed, so SESSION_SECRET is currently unused. Kept only for future use.
SESSION_SECRET=
SESSION_COOKIE_NAME=session
SESSION_COOKIE_PATH=/fonita              # MUST match basePath
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_DAYS=30

# --- Auth: login rate limit --------------------------------
LOGIN_RATE_LIMIT_WINDOW_MS=600000        # 10 minutes
LOGIN_RATE_LIMIT_PER_IP=10
LOGIN_RATE_LIMIT_PER_IDENTITY=5
LOGIN_RATE_LIMIT_PROVIDER=memory         # memory only today; switch when shared store exists

# --- Bootstrap admin (used only by `npm run db:seed`) ------
# Creates the first SUPERADMIN. Without it nobody can sign in at all, because
# CMU OAuth never auto-provisions and only a SUPERADMIN may create users.
# Change the password after the first login.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=          # >= 12 characters

# --- Database (Prisma + PostgreSQL) ------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/fon_ita?schema=public"

# --- File storage ------------------------------------------
UPLOAD_DIR=storage/uploads/itafile       # OUTSIDE public/
MAX_FILE_SIZE_BYTES=10485760             # 10 MB
ALLOWED_FILE_TYPES=png,jpg,jpeg,webp,pdf,xlsx,docx

# --- Public API (rate limit) -------------------------------
# 60 is the frozen-contract value (Laravel throttle:60,1, X-RateLimit-Limit: 60).
# Override only after agreeing with the faculty website team.
PUBLIC_API_RATE_LIMIT_PER_MIN=60

# --- YouTube feed (F28) ------------------------------------
# Channel the public endpoint + home page widget read from.
YOUTUBE_CHANNEL_ID=UCrsvXl143w91ND6BjGn9cZw

# --- CMU Mobile (optional — STUB) --------------------------
# For /cmu-mobile/callback — set only if SCMC one-time-token verify is enabled.
# Leave empty to keep the route as a 501 stub.
CMUMOBILE_TOKEN=

# --- App config --------------------------------------------
NODE_ENV=development                     # development | production
# NEXT_PUBLIC_BASE_PATH=/fonita          # optional: read in client components
